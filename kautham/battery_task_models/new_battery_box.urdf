<?xml version="1.0"?>
<!--
  new_battery_box.urdf
  ====================
  Bandeja de almacenamiento de pilas NUEVAS (color verde).

  Dimensiones exteriores:  70 mm × 70 mm × 30 mm
  Grosor de paredes:         5 mm
  Interior accesible:       60 mm × 60 mm × 25 mm (abierto por arriba)

  Origen URDF: Z = 0 en la base.
  En la escena Kautham el obstacle Home tiene Z = 0.005.
  Borde superior: Z_world = 0.005 + 0.030 = 0.035 m.
  La batería (59 mm) sobresale ~29 mm sobre el borde → fácil de agarrar.
-->
<robot name="new_battery_box">
  <link name="base">

    <!-- ── SUELO (70 × 70 × 5 mm, centro a Z = 2.5 mm) ─────────────────── -->
    <visual>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry><box size="0.070 0.070 0.005"/></geometry>
      <material name="new_box_green_dark">
        <color rgba="0.05 0.60 0.10 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry><box size="0.070 0.070 0.005"/></geometry>
    </collision>

    <!-- ── PARED IZQUIERDA (−X) ──────────────────────────────────────────── -->
    <!--   5 × 70 × 25 mm; centro X = −32.5 mm, centro Z = 5 + 12.5 = 17.5 mm -->
    <visual>
      <origin xyz="-0.0325 0 0.0175" rpy="0 0 0"/>
      <geometry><box size="0.005 0.070 0.025"/></geometry>
      <material name="new_box_green_dark">
        <color rgba="0.05 0.60 0.10 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.0325 0 0.0175" rpy="0 0 0"/>
      <geometry><box size="0.005 0.070 0.025"/></geometry>
    </collision>

    <!-- ── PARED DERECHA (+X) ────────────────────────────────────────────── -->
    <visual>
      <origin xyz="0.0325 0 0.0175" rpy="0 0 0"/>
      <geometry><box size="0.005 0.070 0.025"/></geometry>
      <material name="new_box_green_dark">
        <color rgba="0.05 0.60 0.10 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0325 0 0.0175" rpy="0 0 0"/>
      <geometry><box size="0.005 0.070 0.025"/></geometry>
    </collision>

    <!-- ── PARED DELANTERA (−Y) ───────────────────────────────────────────── -->
    <!--   60 × 5 × 25 mm; centro Y = −32.5 mm                               -->
    <visual>
      <origin xyz="0 -0.0325 0.0175" rpy="0 0 0"/>
      <geometry><box size="0.060 0.005 0.025"/></geometry>
      <material name="new_box_green_dark">
        <color rgba="0.05 0.60 0.10 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.0325 0.0175" rpy="0 0 0"/>
      <geometry><box size="0.060 0.005 0.025"/></geometry>
    </collision>

    <!-- ── PARED TRASERA (+Y) ─────────────────────────────────────────────── -->
    <visual>
      <origin xyz="0 0.0325 0.0175" rpy="0 0 0"/>
      <geometry><box size="0.060 0.005 0.025"/></geometry>
      <material name="new_box_green_dark">
        <color rgba="0.05 0.60 0.10 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.0325 0.0175" rpy="0 0 0"/>
      <geometry><box size="0.060 0.005 0.025"/></geometry>
    </collision>

    <!-- ── ETIQUETA VISUAL "NEW" ──────────────────────────────────────────── -->
    <visual>
      <origin xyz="0 -0.0355 0.0175" rpy="0 0 0"/>
      <geometry><box size="0.040 0.001 0.010"/></geometry>
      <material name="label_white">
        <color rgba="0.95 0.95 0.95 1"/>
      </material>
    </visual>

  </link>
</robot>
