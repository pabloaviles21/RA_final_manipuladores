<?xml version='1.0' encoding='utf-8'?>
<!--
  Escena geométrica utilizada por Kautham para la tarea de cambio de batería.

  El robot UR3 con pinza se coloca en X = 0.37 m, con orientación TH = pi/2,
  para mantener una configuración equivalente al ejemplo original de UR3 y situar
  el brazo frente al área de trabajo.

  La mesa se coloca en X = -0.25 m y Z = 0.03 m. Esta altura se ajustó para que
  la superficie de trabajo quedara correctamente alineada con los modelos de los
  objetos y para evitar colisiones iniciales con la mesa del laboratorio ya que al
  ser la pinza más grande en el laboratorio las planificaciones del kautham a veces
  eran muy bajas y el robot colisionaba con la mesa del laboratorio. Al subir la 
  mesa 3 cm, el robot puede planificar trayectorias más altas y evitar colisiones 
  con la mesa del laboratorio.

  Las cajas fijas se colocan según la distribución medida en el montaje real:
  - device_box:       X =  0.033141 m, Y =  0.063381 m
  - new_battery_box:  X = -0.071928 m, Y = -0.038341 m
  - used_battery_box: X =  0.122062 m, Y =  0.060742 m

  Los objetos manipulables se colocan sobre esas cajas:
  - box_lid:     X = 0.040104 m,  Y = 0.060515 m,  Z = 0.103 m
  - battery_old: X = 0.033141 m,  Y = 0.063381 m,  Z = 0.041 m
  - battery_new: X = -0.071928 m, Y = -0.038341 m, Z = 0.040 m

  Las coordenadas Z de cada objeto no solo indican su posición física, sino que
  también se ajustaron para que cada geometría quedara apoyada sobre su soporte
  sin penetrar otras mallas. Esto fue necesario para evitar errores de colisión
  en Kautham que nos aparecían al intentar planificar.

Se usa OMPL RRTConnect porque el problema se resuelve en el espacio de configuraciones
del UR3, con varios grados de libertad, y este planificador suele encontrar trayectorias
factibles de forma eficiente en este tipo de escenarios.

Parámetros elegidos:

_Incremental (0/1) = 0: se planifica cada consulta de forma completa, ya que nos interesa obtener una trayectoria final válida y no depurar el crecimiento incremental del árbol.
_Max Planning Time = 10: se da suficiente margen para encontrar trayectorias libres de colisión sin hacer que cada intento tarde demasiado.
_Simplify Solution = 2: se usa simplificación para reducir puntos intermedios innecesarios y obtener una trayectoria más limpia que la solución inicial del muestreo.
No sale en el archivo pero de base el planificador lo tiene en 2.
Range = 0.5: se mantiene un avance intermedio del árbol; suficientemente grande para explorar el espacio, pero sin hacer saltos excesivos que puedan dificultar la búsqueda de caminos sin colisión.
-->
<Problem name="OMPL_RRTConnect_battery_change_ur3">
        <Robot robot="/robots/robot_instances/UR_robotiq_85_gripper/ur3_robotiq_85_gripper.urdf.xacro" scale="1.0">
                <KauthamName name="ur3_right" />
                <Home TH="1.570796327" WZ="1.0" WY="0.0" WX="0.0" Z="0.0" Y="0.0" X="0.37" />
                <ViewLink name="robotiq_85_base_link" />
        </Robot>
        <Obstacle obstacle="/obstacles/battery_task/workspace_table.urdf" scale="1.0">
                <KauthamName name="workspace_table" />
                <Home TH="0.0" WZ="0.0" WY="0.0" WX="1.0" Z="0.030000" Y="0.000000" X="-0.250000" />
        </Obstacle>
        <Obstacle obstacle="/obstacles/battery_task/device_box.urdf" scale="1.0">
                <KauthamName name="device_box" />
                <Home TH="0.0" WZ="0.0" WY="0.0" WX="1.0" Z="0.035000" Y="0.063381" X="0.033141" />
        </Obstacle>
        <Obstacle obstacle="/obstacles/battery_task/new_battery_box.urdf" scale="1.0">
                <KauthamName name="new_battery_box" />
                <Home TH="0.0" WZ="0.0" WY="0.0" WX="1.0" Z="0.035000" Y="-0.038341" X="-0.071928" />
        </Obstacle>
        <Obstacle obstacle="/obstacles/battery_task/used_battery_box.urdf" scale="1.0">
                <KauthamName name="used_battery_box" />
                <Home TH="0.0" WZ="0.0" WY="0.0" WX="1.0" Z="0.035000" Y="0.060742" X="0.122062" />
        </Obstacle>
        <Obstacle obstacle="/obstacles/battery_task/lid.urdf" scale="1.0">
                <KauthamName name="box_lid" />
                <Home TH="0.0" WZ="0.0" WY="0.0" WX="1.0" Z="0.103000" Y="0.060515" X="0.040104" />
        </Obstacle>
        <Obstacle obstacle="/obstacles/battery_task/battery_old.urdf" scale="1.0">
                <KauthamName name="battery_old" />
                <Home TH="0.0" WZ="0.0" WY="0.0" WX="1.0" Z="0.041000" Y="0.063381" X="0.033141" />
        </Obstacle>
        <Obstacle obstacle="/obstacles/battery_task/battery_new.urdf" scale="1.0">
                <KauthamName name="battery_new" />
                <Home TH="0.0" WZ="0.0" WY="0.0" WX="1.0" Z="0.040000" Y="-0.038341" X="-0.071928" />
        </Obstacle>
        <Controls robot="controls/right_ur3_with_gripper.cntr" />
        <Planner>
                <Parameters>
                        <Name>omplRRTConnect</Name>
                        <Parameter name="_Cspace Drawn">0</Parameter>
                        <Parameter name="_Incremental (0/1)">0</Parameter>
                        <Parameter name="_Max Planning Time">10</Parameter>
                        <Parameter name="_Path Drawn (0/1)">1</Parameter>
                        <Parameter name="_Simplify Solution">2</Parameter>
                        <Parameter name="_Speed Factor">1</Parameter>
                        <Parameter name="Range">0.5</Parameter>
                </Parameters>
                <Queries>
                        <Query>
                                <RobotControl name="ur3_right_shoulder_pan_joint" init="0.500" goal="0.545" />
                                <RobotControl name="ur3_right_shoulder_lift_joint" init="0.375" goal="0.380" />
                                <RobotControl name="ur3_right_elbow_joint" init="0.500" goal="0.835" />
                                <RobotControl name="ur3_right_wrist_1_joint" init="0.375" goal="0.327" />
                                <RobotControl name="ur3_right_wrist_2_joint" init="0.500" goal="0.375" />
                                <RobotControl name="ur3_right_wrist_3_joint" init="0.500" goal="0.425" />
                                <RobotControl name="ur3_right_gripper_joint" init="0.500" goal="0.813" />
                        </Query>
                </Queries>
        </Planner>
</Problem>